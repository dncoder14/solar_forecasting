# ── Backend (set these on Render) ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Comma-separated list of allowed frontend origins (your Vercel URL)
# Example: ALLOWED_ORIGINS=https://solarvista.vercel.app
ALLOWED_ORIGINS=*

# ── Frontend (set these on Vercel) ────────────────────────────────────────────
# Your Render backend URL (no trailing slash)
VITE_API_URL=https://solarvista-api.onrender.com
